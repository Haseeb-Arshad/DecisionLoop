# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ── CockroachDB ──────────────────────────────────────────────────────────────
# CockroachDB Cloud connection string (Serverless or Basic cluster).
# Get it from: CockroachDB Cloud console → your cluster → "Connect" → "Connection string".
# Must include ?sslmode=verify-full and (for Serverless) the cluster's `options=--cluster=...`
# parameter — the console-generated string already includes both.
DATABASE_URL=postgresql://user:password@host:26257/decisionloop?sslmode=verify-full

# ── AWS (S3 document storage, Bedrock reasoning + embeddings) ───────────────
# Same credentials power S3, Bedrock InvokeModel calls, and (if you deploy
# via the Dockerfile fallback instead of Amplify) the app itself. Prefer an
# IAM role over static keys once this runs on AWS infrastructure — see
# lib/aws/s3.ts / lib/ai/bedrock.ts, both fall back to the default AWS
# credential provider chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=decisionloop-documents

# ── Amazon Bedrock (decision extraction, conflict reasoning, embeddings) ────
# Bedrock model access is opt-in per account/region in the AWS console
# (Bedrock → Model access) — an IAM key alone does not grant it. Enable both
# the reasoning model and Titan Text Embeddings V2 before running the app.
#
# Reasoning: Claude on Bedrock, invoked via bedrock-runtime InvokeModel using
# the Anthropic message format (lib/ai/bedrock.ts). Newer Claude models
# generally require a cross-region inference-profile ID, not the bare model
# ID, for on-demand invocation — the default below is already in that form.
BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Embeddings: Amazon Titan Text Embeddings V2, requested at 512 dimensions to
# match the memory_chunks.embedding VECTOR(512) column (lib/ai/embeddings.ts).
# Optional in dev — falls back to a deterministic local hash-embedding
# provider when AWS_REGION is unset, so `npm run dev` and `npm test` work
# without live AWS credentials.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── CockroachDB Managed MCP Server (Memory Inspector verification) ─────────
# Service-account API key generated in CockroachDB Cloud → Access → Service
# Accounts → create an API key scoped to this cluster with mcp:read.
# Optional: the Memory Inspector degrades gracefully (shows internal trace
# only, flags "MCP cross-check unavailable") when unset.
COCKROACHDB_MCP_SERVICE_KEY=
COCKROACHDB_MCP_URL=https://cockroachlabs.cloud/mcp

# ── Auth ─────────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
