# Optional local configuration. Copy to .env.local; never commit real secrets.
# The CLI and scripts load this file. Process environment takes precedence.
# Leave DATABASE_URL blank to use embedded mode via decisionloop serve.
DATABASE_URL=
DATABASE_POOL_MAX=10
# For managed CockroachDB/PostgreSQL, use the provider's verified TLS URL and CA.
DATABASE_SSL_CA=
DATABASE_SSL_ROOT_CERT=

# Explicit provider selection: none/lexical is useful without external services.
DECISIONLOOP_REASONING_PROVIDER=none
DECISIONLOOP_EMBEDDING_PROVIDER=lexical
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Bedrock options, used only when selected.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional document storage. Prefer a runtime IAM role.
S3_BUCKET_NAME=

# Local serve generates a persistent secret when blank.
# Production start requires a supplied random secret of at least 32 characters.
SESSION_SECRET=
APP_BASE_URL=http://127.0.0.1:4318
DECISIONLOOP_ALLOW_SIGNUP=false
DECISIONLOOP_TRUST_PROXY=false

# Optional CockroachDB MCP cross-check.
COCKROACHDB_MCP_SERVICE_KEY=
COCKROACHDB_MCP_CLUSTER_ID=
COCKROACHDB_MCP_DATABASE=
COCKROACHDB_MCP_URL=https://cockroachlabs.cloud/mcp

# GitHub App: see docs/v2/github-app.md.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=

# CLI / SDK / MCP clients; leave blank to use .decisionloop credentials.
DECISIONLOOP_URL=
DECISIONLOOP_API_KEY=
DECISIONLOOP_AGENT_KEY=
