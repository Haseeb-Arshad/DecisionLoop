{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "decisionloop hook session-start", "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "decisionloop hook user-prompt-submit", "timeout": 15 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "decisionloop hook pre-tool-use", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "decisionloop hook stop", "timeout": 15 }] }
    ]
  }
}
