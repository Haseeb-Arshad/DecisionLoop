# Copy to .env.production. Generate SESSION_SECRET with crypto.randomBytes(32).
# Use a URL-safe PostgreSQL password (or URL-encode it in DATABASE_URL).
POSTGRES_PASSWORD=
SESSION_SECRET=
NODE_ENV=production
APP_BASE_URL=https://decisionloop.example.com
DECISIONLOOP_ALLOW_SIGNUP=false
DECISIONLOOP_TRUST_PROXY=false
DECISIONLOOP_REASONING_PROVIDER=none
DECISIONLOOP_EMBEDDING_PROVIDER=lexical
# To bootstrap one owner, temporarily allow signup, create the account, then close it.
# Model and S3 settings are optional; see .env.example.
